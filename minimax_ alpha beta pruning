import math

# Task 2: Minimax with leaf counter
def minimax(depth, index, max_turn, scores, target, count):

    if depth == target:
        count[0] += 1
        return scores[index]

    if max_turn:
        left = minimax(depth + 1, index * 2, False,
                       scores, target, count)
        right = minimax(depth + 1, index * 2 + 1, False,
                        scores, target, count)
        return max(left, right)

    else:
        left = minimax(depth + 1, index * 2, True,
                       scores, target, count)
        right = minimax(depth + 1, index * 2 + 1, True,
                        scores, target, count)
        return min(left, right)


# Alpha-Beta pruning with leaf counter
def alphabeta(depth, index, max_turn, scores,
              target, alpha, beta, count):

    if depth == target:
        count[0] += 1
        return scores[index]

    if max_turn:
        value = float('-inf')

        for i in range(2):
            result = alphabeta(
                depth + 1, index * 2 + i, False,
                scores, target, alpha, beta, count
            )

            value = max(value, result)
            alpha = max(alpha, value)

            if alpha >= beta:
                break

        return value

    else:
        value = float('inf')

        for i in range(2):
            result = alphabeta(
                depth + 1, index * 2 + i, True,
                scores, target, alpha, beta, count
            )

            value = min(value, result)
            beta = min(beta, value)

            if alpha >= beta:
                break

        return value


