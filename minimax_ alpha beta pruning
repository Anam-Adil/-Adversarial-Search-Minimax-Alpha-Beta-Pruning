scores = [3, 5, 2, 9, 0, 7]
target = math.ceil(math.log2(len(scores)))

# Complete the binary tree
scores += [0] * (2 ** target - len(scores))

m_count = [0]
m_value = minimax(0, 0, True, scores, target, m_count)

a_count = [0]
a_value = alphabeta(
    0, 0, True, scores, target,
    float('-inf'), float('inf'), a_count
)

print("Minimax value:", m_value)
print("Minimax leaves evaluated:", m_count[0])
print("Alpha-Beta value:", a_value)
print("Alpha-Beta leaves evaluated:", a_count[0])


